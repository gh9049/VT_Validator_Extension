{
  "manifest_version": 3,
  "name": "OSINT IP/URL/SHA-Scanner",
  "version": "3.0.0",
  "description": "Scan selected text across multiple OSINT tools simultaneously.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configure Scanners"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/main-icon.png",
    "48": "icons/main-icon.png",
    "128": "icons/main-icon.png"
  }
}